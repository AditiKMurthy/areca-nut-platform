# Copy this file to backend/.env and replace the placeholders.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Use a long, random value; generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-session-secret

ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep false for local HTTP development. Set true when deployed over HTTPS.
COOKIE_SECURE=false

# Optional: set AUTH_REQUIRED=false only if analysis should be public.
# Authentication is enabled automatically when valid Google credentials are configured.
